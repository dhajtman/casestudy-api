{
  "family": "springboot-task",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::241296256890:role/ECSTaskExecution-Role",
  "containerDefinitions": [
    {
      "name": "springboot-container",
      "image": "241296256890.dkr.ecr.eu-north-1.amazonaws.com/case-study-api",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000
        }
      ]
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ]
}